# AURA Environment Configuration

# Speech Recognition Model (tiny, base, small, medium)
AURA_WHISPER_MODEL=base
AURA_WHISPER_DEVICE=cpu
AURA_WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech Configuration
AURA_TTS_RATE=175
AURA_TTS_VOLUME=1.0

# Optional Local / Cloud AI
AURA_AI_ENABLED=false
AURA_AI_PROVIDER=ollama
AURA_AI_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Security and Logging
AURA_LOG_LEVEL=INFO
AURA_DB_PATH=aura.db

